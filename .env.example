# The domain your app will be served on.
# Must have a DNS A record pointing at this server's IP before you start.
DOMAIN=yourapp.com

# Email used for Let's Encrypt certificate expiry notices.
ACME_EMAIL=you@example.com

# Postgres credentials — change these before going live.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=appdb
